PORT=4000

# Resend (resend.com) API key used to send the verification email. Most
# hosting platforms (Render, Railway, etc.) block outbound SMTP, so email is
# sent over Resend's HTTPS API instead of raw SMTP.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender identity. The default onboarding@resend.dev sandbox address can only
# deliver to the email you signed up to Resend with, unless you verify your
# own domain in the Resend dashboard.
RESEND_FROM=Demand Forecasting <onboarding@resend.dev>

# Where the "approve this account" email is sent.
ADMIN_EMAIL=sayandeepvirat10@gmail.com

# Base URL this server is reachable at — used to build the verification link
# inside the email. Only needs changing if you deploy the backend somewhere
# other than localhost.
PUBLIC_BASE_URL=http://localhost:4000

# Origin(s) allowed to call this API. Comma-separated for multiple (e.g. a
# Vercel deployment plus the local Vite dev server).
FRONTEND_URL=http://localhost:5173,https://your-app.vercel.app

# Optional: a specific admin account that gets (re-)created as active on every
# server startup. Needed because most free hosting tiers wipe local disk on
# every redeploy — without this, a manually-created account would vanish the
# next time you push code. Leave all three unset to skip this.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Postgres connection string (e.g. from neon.tech's free tier). Backs the real
# supply-chain data (records table), sessions, and server-side anomaly scoring.
# When unset, /api/data, /api/events and /api/ingest are disabled and the app
# falls back to auth-only mode — nothing crashes, those routes just 404.
DATABASE_URL=

# Shared secret for external systems pushing real data in via /api/ingest/*
# (a webhook, a script, backend/scripts/poll-example.js). Generate any long
# random string — this is separate from user login on purpose, since external
# systems shouldn't need a human account.
INGEST_API_KEY=

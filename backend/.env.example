PORT=4000

# Gmail account that SENDS the verification emails. Requires 2-Step Verification
# enabled on this account and an App Password generated at
# https://myaccount.google.com/apppasswords (NOT your normal Gmail password).
GMAIL_USER=your-sending-account@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Where the "approve this account" email is sent.
ADMIN_EMAIL=sayandeepvirat10@gmail.com

# Base URL this server is reachable at — used to build the verification link
# inside the email. Only needs changing if you deploy the backend somewhere
# other than localhost.
PUBLIC_BASE_URL=http://localhost:4000

# Origin allowed to call this API (the Vite dev server).
FRONTEND_URL=http://localhost:5173
